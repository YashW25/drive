generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  phoneNumber      String      @unique @map("phone_number")
  telegramUserId   String?     @unique @map("telegram_user_id")
  displayName      String      @map("display_name")
  avatarUrl        String?     @map("avatar_url")
  email             String?     @map("email")
  isProfileComplete Boolean     @default(false) @map("is_profile_complete")
  role              String      @default("USER")
  settingsJson      String      @default("{}") @map("settings_json")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  sessions         Session[]
  folders          Folder[]
  files            File[]
  fileVersions     FileVersion[]
  shares           Share[]
  starredItems     StarredItem[]
  trashItems       TrashItem[]
  uploadSessions   UploadSession[]
  downloadSessions DownloadSession[]
  auditLogs        AuditLog[]
  googleConnection GoogleConnection?
  googleMigrations GoogleMigration[]
  userRequests     UserRequest[]

  @@map("users")
}

model OtpRecord {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  otpHash     String    @map("otp_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("otp_records")
}

model UserRequest {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  requestType String   @map("request_type")
  description String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_requests")
}

model Session {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  tokenHash             String   @unique @map("token_hash")
  telegramSessionString String?  @map("telegram_session_string")
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent")
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Folder {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  parentFolderId String?   @map("parent_folder_id")
  name           String
  isStarred      Boolean   @default(false) @map("is_starred")
  isTrashed      Boolean   @default(false) @map("is_trashed")
  trashedAt      DateTime? @map("trashed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentFolder Folder?     @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subFolders   Folder[]    @relation("FolderHierarchy")
  files        File[]
  shares       Share[]

  @@index([userId])
  @@index([parentFolderId])
  @@index([name])
  @@map("folders")
}

model File {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  folderId          String?   @map("folder_id")
  name              String
  originalName      String    @map("original_name")
  mimeType          String    @map("mime_type")
  extension         String
  size              BigInt    @default(0)
  hash              String    @default("")
  storageProvider   String    @default("TELEGRAM") @map("storage_provider")
  storageObjectId   String    @default("") @map("storage_object_id")
  telegramFileId    String?   @map("telegram_file_id")
  telegramMessageId Int?      @map("telegram_message_id")
  telegramChatId    String?   @map("telegram_chat_id")
  thumbnailId       String?   @map("thumbnail_id")
  isStarred         Boolean   @default(false) @map("is_starred")
  isTrashed         Boolean   @default(false) @map("is_trashed")
  trashedAt         DateTime? @map("trashed_at")
  currentVersionId      String?   @map("current_version_id")
  isGoogleDriveBackup   Boolean   @default(false) @map("is_google_drive_backup")
  googleDriveFileId     String?   @map("google_drive_file_id")
  googleDriveSourcePath String?   @map("google_drive_source_path")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder           Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileVersions     FileVersion[]
  shares           Share[]
  previews         FilePreview[]
  downloadSessions DownloadSession[]

  @@index([userId])
  @@index([folderId])
  @@index([name])
  @@index([mimeType])
  @@index([hash])
  @@index([googleDriveFileId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("files")
}

model FileVersion {
  id              String   @id @default(uuid())
  fileId          String   @map("file_id")
  versionNumber   Int      @default(1) @map("version_number")
  size            BigInt   @default(0)
  hash            String   @default("")
  storageProvider String   @default("TELEGRAM") @map("storage_provider")
  storageObjectId String   @default("") @map("storage_object_id")
  telegramFileId  String?  @map("telegram_file_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([fileId])
  @@map("file_versions")
}

model Share {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  fileId       String?   @map("file_id")
  folderId     String?   @map("folder_id")
  token        String    @unique
  permission   String    @default("VIEWER") // VIEWER, DOWNLOADER, EDITOR
  passwordHash String?   @map("password_hash")
  expiresAt    DateTime? @map("expires_at")
  accessCount  Int       @default(0) @map("access_count")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("shares")
}

model StarredItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  itemType  String   @map("item_type") // FILE or FOLDER
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@map("starred_items")
}

model TrashItem {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  itemType     String   @map("item_type") // FILE or FOLDER
  itemId       String   @map("item_id")
  deletedAt    DateTime @default(now()) @map("deleted_at")
  autoDeleteAt DateTime @map("auto_delete_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@map("trash_items")
}

model UploadSession {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  folderId       String?  @map("folder_id")
  filename       String
  fileSize       BigInt   @map("file_size")
  mimeType       String   @map("mime_type")
  status         String   @default("PENDING") // PENDING, UPLOADING, COMPLETED, FAILED, CANCELLED
  uploadedBytes  BigInt   @default(0) @map("uploaded_bytes")
  chunksCount    Int      @default(1) @map("chunks_count")
  tempFilePath   String?  @map("temp_file_path")
  errorReason    String?  @map("error_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("upload_sessions")
}

model DownloadSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  fileId       String   @map("file_id")
  downloadUrl  String   @map("download_url")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("download_sessions")
}

model FilePreview {
  id           String   @id @default(uuid())
  fileId       String   @map("file_id")
  previewType  String   @map("preview_type") // THUMBNAIL, FIRST_PAGE, TEXT_SUMMARY, AUDIO_WAVEFORM
  previewPath  String   @map("preview_path")
  metadataJson String   @default("{}") @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("file_previews")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadataJson String   @default("{}") @map("metadata_json")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model GoogleConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  email        String
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  tokenExpiry  DateTime @map("token_expiry")
  scopes       String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("google_connections")
}

model GoogleMigration {
  id                        String                @id @default(uuid())
  userId                    String                @map("user_id")
  backupFolderName          String                @map("backup_folder_name")
  backupFolderId            String?               @map("backup_folder_id")
  status                    String                @default("SCANNING") // SCANNING, SCAN_COMPLETED, IN_PROGRESS, VERIFYING, COMPLETED, COMPLETED_WITH_ERRORS, FAILED, CANCELLED
  deleteOriginals           Boolean               @default(false) @map("delete_originals")
  deleteConfirmed           Boolean               @default(false) @map("delete_confirmed")
  totalFilesDiscovered      Int                   @default(0) @map("total_files_discovered")
  totalFoldersDiscovered    Int                   @default(0) @map("total_folders_discovered")
  totalBytesDiscovered      BigInt                @default(0) @map("total_bytes_discovered")
  totalGoogleDriveBytes     BigInt                @default(0) @map("total_google_drive_bytes")
  usedGoogleDriveBytes      BigInt                @default(0) @map("used_google_drive_bytes")
  unsupportedCount          Int                   @default(0) @map("unsupported_count")
  filesMigrated             Int                   @default(0) @map("files_migrated")
  foldersMigrated           Int                   @default(0) @map("folders_migrated")
  bytesTransferred          BigInt                @default(0) @map("bytes_transferred")
  filesVerified             Int                   @default(0) @map("files_verified")
  failedCount               Int                   @default(0) @map("failed_count")
  skippedCount              Int                   @default(0) @map("skipped_count")
  deletedFromGoogleCount    Int                   @default(0) @map("deleted_from_google_count")
  currentFileName           String?               @map("current_file_name")
  currentFileStatus         String?               @map("current_file_status")
  transferSpeed             Float                 @default(0) @map("transfer_speed")
  estimatedRemainingSeconds Int                   @default(0) @map("estimated_remaining_seconds")
  startedAt                 DateTime?             @map("started_at")
  completedAt               DateTime?             @map("completed_at")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GoogleMigrationItem[]

  @@index([userId])
  @@index([status])
  @@map("google_migrations")
}

model GoogleMigrationItem {
  id                String    @id @default(uuid())
  migrationId       String    @map("migration_id")
  googleFileId      String    @map("google_file_id")
  googleParentId    String?   @map("google_parent_id")
  name              String
  relativePath      String    @default("") @map("relative_path")
  mimeType          String    @map("mime_type")
  isFolder          Boolean   @default(false) @map("is_folder")
  isWorkspaceFile   Boolean   @default(false) @map("is_workspace_file")
  exportMimeType    String?   @map("export_mime_type")
  exportExtension   String?   @map("export_extension")
  size              BigInt    @default(0)
  md5Checksum       String?   @map("md5_checksum")
  status            String    @default("DISCOVERED") // DISCOVERED, QUEUED, DOWNLOADING, UPLOADING, VERIFYING, VERIFIED, COMPLETED, FAILED, SKIPPED
  teledriveFolderId String?   @map("teledrive_folder_id")
  teledriveFileId   String?   @map("teledrive_file_id")
  errorReason       String?   @map("error_reason")
  googleModifiedAt  DateTime? @map("google_modified_at")
  googleWebViewLink String?   @map("google_web_view_link")
  deletedFromGoogle Boolean   @default(false) @map("deleted_from_google")
  deleteError       String?   @map("delete_error")

  migration GoogleMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  @@index([migrationId])
  @@index([googleFileId])
  @@index([status])
  @@map("google_migration_items")
}
